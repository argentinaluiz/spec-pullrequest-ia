# Os valores deste projeto para as skills genéricas do kit, na sintaxe de `git config`: um arquivo só, com uma seção por
# assunto, e cada skill lê as seções de que precisa. É o dono único destes valores. Quem lê o quê:
#
#   tickets, node, plano   /plan-ticket (a pasta dos tickets é também da /revisao-conformidade e da /implement)
#   contrato               /plan-ticket (o comando e os arquivos) e /revisao-conformidade (o desvio)
#   revisao                /revisao-conformidade e /implement
#   verificacao            /implement e /worktree
#   frentes, convergencia, sincronizar, gerado   /worktree (o núcleo lê `frentes` e `convergencia`; o agente lê o resto)
#
# O que não está aqui vale o padrão da skill: os status do Linear, o tipo da branch e o revisor. Uma chave com o valor
# `nenhum` na skill (a pasta dos documentos, o contrato) fica de fora quando o projeto não a tem.

# A pasta dos tickets (nela o Git versiona só o aceite e o mapa de testes de cada ticket; a revisão e a página do plano
# ficam fora do Git) e a dos documentos do projeto, cujas mudanças a página do plano destaca. O hook de congelamento
# recebe a pasta dos tickets na linha de comando dele, no .claude/settings.json.
[tickets]
	pasta = docs/tickets
	documentos = docs

# O comando do Node, que roda no contêiner `api` porque a máquina não roda `node` (chamado como `<comando> <script> -`,
# da raiz do repositório).
[node]
	comando = scripts/node-in-api.sh

# O contrato: a visão legível dele entre dois pontos do Git, os arquivos que são o dono dele (separados por espaço) e o
# que mostra o desvio dele desde o commit de plano (só avisa, e é também o aviso do modo completo da verificação).
[contrato]
	comando = scripts/contract-view.sh
	arquivos = apps/api/openapi.json apps/api/prisma/schema.prisma
	desvio = scripts/contract-drift.sh

# O atalho que chama o script da página do plano com os valores de cima: `<atalho> <issue pai> <ticket> [<commit de plano>]`.
[plano]
	atalho = .claude/skills/verificar/scripts/verify.sh plan

# A revisão de conformidade. A base é a HARNESS_BASE_REF, com `origin/main` por padrão (o agente expande a expressão e a
# passa ao script dos insumos, que não lê a variável). O código que pede revisão: toda mudança que casa com `sempre`
# (`**` atravessa as barras), com ou sem ticket, e a que casa com `com-aceite` só num ticket com aceite. Uma mudança só
# de documento não pede revisão.
[revisao]
	base = ${HARNESS_BASE_REF:-origin/main}
	sempre = apps/**
	com-aceite = .claude/hooks/**
	com-aceite = .github/**
	com-aceite = .config/**
	com-aceite = scripts/**
	com-aceite = .claude/skills/*/scripts/**
	com-aceite = .claude/skills/*/hooks/**

# O limite de frentes ao todo, contando o checkout principal quando ele não está na main, e o comando de ambiente de
# cada frente, que o núcleo chama (o caminho vale a partir da raiz do checkout). O limite é também o teto do ambiente
# por slot: o frente-ambiente.sh aceita os slots de 0 a 3 (docs/lld.md, seção 6), então subir daqui de 3 pede mudar lá.
[frentes]
	limite = 3
	ambiente = scripts/frente-ambiente.sh

# Os pontos de convergência: arquivos em que duas frentes paralelas costumam esbarrar, em cinco tipos. O tipo é a
# chave e o caminho é o valor, que aceita `*` (casa também as barras). Vale o primeiro padrão que casa, na ordem
# daqui; um arquivo que nenhum casa é código e pede atenção. O núcleo usa a classificação para separar os conflitos do
# `listar`, e o modo sincronizar usa para saber o que resolver por regra (a regra de cada tipo é desse modo).
#
#   gerado       o snapshot da OpenAPI, regenerado a partir do código mergeado
#   migracoes    a pasta de migrações, cuja pasta atrasada se recria com nome novo
#   registros    as listas em que cada frente acrescenta um item, em ordem alfabética
#   documentos   os documentos do projeto, que a pessoa junta à mão
#   manual       o schema do Prisma e o arquivo de exemplo de variáveis, que se juntam à mão, como código
[convergencia]
	gerado = apps/api/openapi.json

	migracoes = apps/api/prisma/migrations/*

	registros = apps/api/src/app.module.ts
	registros = apps/api/src/config/env.schema.ts
	registros = apps/web/lib/api/types.ts

	documentos = docs/lld.md
	documentos = AGENTS.md
	documentos = apps/api/AGENTS.md
	documentos = apps/web/AGENTS.md
	documentos = GLOSSARY.md
	documentos = docs/design-system.md

	manual = apps/api/prisma/schema.prisma
	manual = apps/api/.env.example

# Os comandos do passo de ambiente do modo sincronizar, na ordem em que rodam, cada um na pasta da frente (o Compose
# dela é só dela). Uma chave repetida é uma lista de comandos em sequência. O que cada passo faz e quando roda é do
# modo; aqui só está o comando.
#
#   atualizar-ambiente  as dependências, as variáveis novas do .env.example, o cliente do Prisma e as migrações
#   recriar-banco       derruba o banco com o volume e sobe de novo, depois que uma migração foi renomeada ou apagada
#   gerar-migracao      gera de novo a migração apagada no sync (o <nome> é o da migração)
#   subir-aplicacoes    sobe a API e a web em segundo plano; a verificação completa aborta se elas estão fora do ar
[sincronizar]
	atualizar-ambiente = docker compose -f compose.dev.yaml exec api pnpm install
	atualizar-ambiente = docker compose -f compose.dev.yaml exec web pnpm install
	atualizar-ambiente = docker compose -f compose.dev.yaml exec api pnpm setup:dev
	recriar-banco = docker compose -f compose.dev.yaml down -v
	recriar-banco = docker compose -f compose.dev.yaml up -d --wait
	gerar-migracao = docker compose -f compose.dev.yaml exec api pnpm exec prisma migrate dev --name <nome>
	subir-aplicacoes = docker compose -f compose.dev.yaml exec -d api pnpm start:dev
	subir-aplicacoes = docker compose -f compose.dev.yaml exec -d web pnpm dev --hostname 0.0.0.0

# O comando que regenera cada arquivo gerado (do tipo `gerado`), pelo caminho dele. Roda depois de subir as aplicações
# e com o código já mesclado. Um arquivo gerado em conflito sem comando aqui faz o agente perguntar.
[gerado "apps/api/openapi.json"]
	regenerar = docker compose -f compose.dev.yaml exec api pnpm openapi:generate openapi.json

# O comando da verificação completa, que roda uma vez, em segundo plano (a /implement e o modo sincronizar da /worktree). O <arquivo> é o corpo do pull request, com a
# seção `## Aceite`: o comando o recebe quando a branch altera `apps/`.
[verificacao]
	completa = ACCEPTANCE_BODY_FILE=<arquivo> .claude/skills/verificar/scripts/verify.sh full
