{
  "permissions": {
    "deny": [
      "Read(./docs/sessoes/**)",
      "Edit(./docs/sessoes/**)",
      "Read(./docs/specs/**)",
      "Edit(./docs/specs/**)",
      "Read(./docs/Gerenciador de arquivos.fig)",
      "Edit(./docs/Gerenciador de arquivos.fig)",
      "Bash(gh pr merge:*)"
    ],
    "ask": [
      "Edit(./.github/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/agents/**)",
      "Edit(./scripts/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-verify.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-verify.sh",
            "timeout": 300,
            "statusMessage": "Verificando tipos e lint do código alterado"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "chrome-devtools",
    "playwright",
    "linear-server"
  ],
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  }
}
