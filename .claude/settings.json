{
  "permissions": {
    "deny": [
      "Read(./docs/sessoes/**)",
      "Edit(./docs/sessoes/**)",
      "Read(./docs/specs/**)",
      "Edit(./docs/specs/**)",
      "Read(./docs/Gerenciador de arquivos.fig)",
      "Edit(./docs/Gerenciador de arquivos.fig)",
      "Edit(./.harness/**)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-verify.sh",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/freeze-acceptance.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-touched.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-verify.sh",
            "timeout": 300,
            "statusMessage": "Verificando tipos e lint do código alterado"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Identify and activate relevant skills for this task.'"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "chrome-devtools",
    "playwright",
    "linear-server"
  ],
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  }
}
